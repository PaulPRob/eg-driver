# /dev/eg0 .. /dev/eg7 are created by the driver via device_create(); this rule
# only sets ownership.  All eight minors are aliases of the same card: minor 0
# is conventionally the read/write node (it is the one that can take write
# ownership) and the rest are read-only observers.
#
# The 2.6 driver created no nodes at all - the operator ran mknod by hand, and
# the site scripts did so mode 666.  Ubuntu has no static /dev, so the driver
# registers a class and udev applies this rule.
#
# Change GROUP if the event generator software runs as a dedicated account:
# that account must be a member of whichever group is named here.
SUBSYSTEM=="eg", KERNEL=="eg[0-9]*", MODE="0660", GROUP="plugdev"

# Let systemd units order themselves against dev-eg0.device.
SUBSYSTEM=="eg", KERNEL=="eg0", TAG+="systemd"
